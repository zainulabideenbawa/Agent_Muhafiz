# ── Database ─────────────────────────────────────────────────────────
# Get from: https://neon.tech
DATABASE_URL=postgresql://...

# ── App Settings ──────────────────────────────────────────────────────
PORT=3001

# ── Google APIs (required for Maps geocoding) ─────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services
# Enable: Geocoding API, Maps JavaScript API
GOOGLE_API_KEY=your_google_api_key_here

# ── Weather API (optional — falls back to simulation if missing) ───────
# Free plan at: https://openweathermap.org/api → Current Weather Data
OPENWEATHER_API_KEY=your_openweathermap_key_here

# ── Traffic API (optional — falls back to simulation if missing) ───────
# Free plan at: https://developer.tomtom.com → Traffic Flow API
TOMTOM_API_KEY=your_tomtom_api_key_here

# ── OSINT / Twitter Scraping (optional) ───────────────────────────────
# Get from: https://apify.com → your actor token
APIFY_TOKEN=your_apify_token_here
APIFY_ACTOR_ID=apify/twitter-scraper

# ── AI Model ──────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY_GEMINI=your_gemini_api_key_here
